# Copia este fichero a .env y rellena las claves.

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Voz del entrevistador en ElevenLabs (ID de voz de su biblioteca)
ELEVENLABS_VOICE_ID=

# Modelo para el entrevistador: prioriza latencia (responde en tiempo real)
INTERVIEWER_MODEL=claude-sonnet-5-5
# Modelo para el evaluador: prioriza calidad (corre al final, sin prisa)
EVALUATOR_MODEL=claude-opus-5-5

# Persona del entrevistador: nombre de un fichero en prompts/ (sin .md)
PERSONA=recruiter
