# Copy this file to .env and fill in your keys there (never in this file).

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Interviewer voice (use a default ElevenLabs voice on the free plan)
ELEVENLABS_VOICE_ID=

# Interviewer model: optimise for latency (it answers in real time)
INTERVIEWER_MODEL=claude-sonnet-5-5
# Evaluator model: optimise for quality (runs after the call)
EVALUATOR_MODEL=claude-opus-5-5

# Interviewer persona: a file name in prompts/ (without .md)
PERSONA=recruiter

# Optional: seconds of silence before your turn ends (raise it if you get cut off)
# USER_SPEECH_TIMEOUT=1.5

# Optional: number of questions before the interviewer closes the call
# NUM_QUESTIONS=3